# Serdal: своя иконка и русский перевод клиента (файлы в /etc/bigbluebutton/serdal, переживают обновления BBB)
location = /favicon.ico {
    alias /etc/bigbluebutton/serdal/favicon.ico;
}
location = /html5client/locales/ru.json {
    alias /etc/bigbluebutton/serdal/ru.json;
    add_header Cache-Control "no-cache";
}
# Свой стиль клиента и шрифты (кириллица для Source Sans Pro); адрес стиля с ?v=<отпечаток> — кэш можно держать долго
location ^~ /serdal/ {
    alias /etc/bigbluebutton/serdal/public/;
    add_header Cache-Control "public, max-age=604800";
}
