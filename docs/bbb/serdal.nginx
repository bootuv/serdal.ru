# Serdal: своя иконка и русский перевод клиента (файлы в /etc/bigbluebutton/serdal, переживают обновления BBB)
location = /favicon.ico {
    alias /etc/bigbluebutton/serdal/favicon.ico;
}
location = /html5client/locales/ru.json {
    alias /etc/bigbluebutton/serdal/ru.json;
    add_header Cache-Control "no-cache";
}
# Свой стиль клиента и шрифт Inter; адрес стиля с ?v=<отпечаток> — кэш можно держать долго
location ^~ /serdal/ {
    alias /etc/bigbluebutton/serdal/public/;
    add_header Cache-Control "public, max-age=604800";
}
# Шрифты клиента: вместо штатного fonts.css (Source Sans Pro, только латиница) — наш: Inter под тем же именем.
# Штатные объявления иначе подключаются позже нашего customStyleUrl и перебивают его
location = /html5client/stylesheets/fonts.css {
    alias /etc/bigbluebutton/serdal/public/serdal.css;
    default_type text/css;
    add_header Cache-Control "no-cache";
}
# Страница клиента: своя копия index.html (serdal-bbb-branding) — без предзагрузки Source Sans Pro, с заголовком Serdal
location = /html5client/ {
    root /etc/bigbluebutton/serdal;
    try_files /index.html =404;
    default_type text/html;
    add_header Cache-Control "no-cache";
}
location = /html5client/index.html {
    root /etc/bigbluebutton/serdal;
    try_files /index.html =404;
    default_type text/html;
    add_header Cache-Control "no-cache";
}
