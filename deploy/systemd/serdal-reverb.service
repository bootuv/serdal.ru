[Unit]
Description=Serdal.ru Reverb WebSocket
After=network.target

[Service]
# Слушаем только localhost: наружу WebSocket отдаёт nginx (location /app/ → 127.0.0.1:6001)
User=www-data
Group=www-data
WorkingDirectory=/var/www/serdal.ru
ExecStart=/usr/bin/php8.4 artisan reverb:start --host=127.0.0.1 --port=6001
Restart=always
RestartSec=5
SyslogIdentifier=serdal-reverb
MemoryMax=256M
RuntimeMaxSec=604800
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
