[Unit]
Description=Serdal.ru Reverb WebSocket
After=network.target
PartOf=serdal.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/serdal.ru
ExecStart=/usr/bin/php8.4 artisan reverb:start --host=0.0.0.0 --port=6001
Restart=always
RestartSec=5
SyslogIdentifier=serdal-reverb
MemoryMax=256M
RuntimeMaxSec=604800
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=serdal.target
