[Unit]
Description=Serdal.ru Pulse Worker
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/serdal.ru
ExecStart=/usr/bin/php8.4 artisan pulse:check
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=serdal-pulse
MemoryMax=256M
RuntimeMaxSec=86400

[Install]
WantedBy=multi-user.target
